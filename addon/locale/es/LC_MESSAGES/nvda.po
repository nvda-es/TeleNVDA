"TeleNVDA is already connected. Disconnect before opening a new connection."
msgstr ""
"TeleNVDA ya está conectado. Desconéctalo antes de establecer una nueva "
"conexión."

#: addon\globalPlugins\remoteClient\__init__.py:750
#: addon\globalPlugins\remoteClient\__init__.py:806
