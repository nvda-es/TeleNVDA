msgstr ""
"No se ha podido contactar con el servicio de comprobación de puertos o el "
"dispositivo UPNP, obtén tu dirección IP manualmente y abre los puertos si es "
"necesario. Consulta el registro de NVDA para más detalles."

#: addon\globalPlugins\remoteClient\dialogs.py:203
msgid "Client"
msgstr "Cliente"

#: addon\globalPlugins\remoteClient\dialogs.py:203
msgid "Server"
msgstr "Servidor"

#: addon\globalPlugins\remoteClient\dialogs.py:207
#: addon\globalPlugins\remoteClient\dialogs.py:279
msgid "Control another machine"
msgstr "Controlar otro equipo"

#: addon\globalPlugins\remoteClient\dialogs.py:207
#: addon\globalPlugins\remoteClient\dialogs.py:279
msgid "Allow this machine to be controlled"
msgstr "Permitir que controlen este equipo"

#: addon\globalPlugins\remoteClient\dialogs.py:235
#: addon\globalPlugins\remoteClient\dialogs.py:392
msgid "Both host and key must be set."
msgstr "Tanto el equipo como la clave deben estar configurados."

#. Translators: error message for key/password length less than 6 characters
#: addon\globalPlugins\remoteClient\dialogs.py:239
#: addon\globalPlugins\remoteClient\dialogs.py:253
#: addon\globalPlugins\remoteClient\dialogs.py:399
msgid "The key must be longer than 6 characters."
msgstr "La clave debe tener más de seis caracteres."

#. Translators: error message for key/password being sequential, example 123456
#: addon\globalPlugins\remoteClient\dialogs.py:244
#: addon\globalPlugins\remoteClient\dialogs.py:258
#: addon\globalPlugins\remoteClient\dialogs.py:404
