"The key must not be sequential. Please, avoid keys such as 1234, 4321 or "
"similar."
msgstr ""
"La clave no debe ser secuencial. Por favor, evita claves como 1234, 4321 o "
"similar."

#: addon\globalPlugins\remoteClient\dialogs.py:249
#: addon\globalPlugins\remoteClient\dialogs.py:395
msgid "Both port and key must be set."
msgstr "Se deben establecer tanto el puerto como la clave."

#. Translators: title for the TeleNVDA settings category in NVDA settings dialog
#. Translators: script category for add-on gestures
#: addon\globalPlugins\remoteClient\dialogs.py:266
#: addon\globalPlugins\remoteClient\__init__.py:74
#: addon\globalPlugins\remoteClient\__init__.py:187
msgid "TeleNVDA"
msgstr "TeleNVDA"

#. Translators: A checkbox in add-on options dialog to set whether remote server is started when NVDA starts.
#: addon\globalPlugins\remoteClient\dialogs.py:270
