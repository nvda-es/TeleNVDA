msgstr "مدت زمان عدم فعالیت (روز: ساعت: دقیقه):"

#: addon\globalPlugins\remoteClient\dialogs.py:501
msgid ""
"Format: days:hours:minutes. For example, 30:00:00 means 30 days and 00:00:01 "
