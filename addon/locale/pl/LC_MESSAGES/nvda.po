msgstr ""
"Klucz nie może być sekwencyjny. Proszę unikać kluczy takich jak 1234, 4321 i "
"podobnych."

#: addon\globalPlugins\remoteClient\dialogs.py:451
#: addon\globalPlugins\remoteClient\dialogs.py:823
msgid "Both port and key must be set."
msgstr "Oba pola Port i klucz muszą być ustawione."

